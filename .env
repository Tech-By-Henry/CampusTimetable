# .env (development)

# Django
DEBUG=True
SECRET_KEY=dev-secret-change-this-please

# Hosts & security
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Africa/Lagos

# Database (choose ONE)
# SQLite (default via settings fallback) — leave DATABASE_URL unset to use sqlite
# or Postgres:
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/campus_timetable

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=12000
REFRESH_TOKEN_LIFETIME_DAYS=7
# Optional separate signing key for JWT (otherwise SECRET_KEY is used)
# JWT_SIGNING_KEY=dev-jwt-signing-key-change-me

# One-time SuperAdmin setup code (dev only)
SUPERADMIN_SETUP_CODE=DEV-OT-12345

# If you deploy behind a domain and need CSRF relax
# CSRF_TRUSTED_ORIGINS=https://your-ngrok-url.ngrok.io,https://api.yourdomain.com
